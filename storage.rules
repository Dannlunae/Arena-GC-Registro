rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos (JPG) y PDF de clientes: un archivo por cliente
    match /cyber/{localId}/clientes/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'application/pdf'];
      allow delete: if request.auth != null;
    }
  }
}
